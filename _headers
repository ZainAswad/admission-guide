# إعدادات Cloudflare Pages — تُقابل headers في vercel.json قاعدةً بقاعدة.
# (Vercel يتجاهل هذا الملف، فوجوده آمن على الاستضافتين)
#
# القواعد غير متداخلة عمداً: لا مسار تطابقه قاعدتان تضبطان Cache-Control،
# فلا يتوقّف الناتج على أيّ قاعدة ترجّحها المنصّة عند التطابق.
# إن أضفت قاعدة هنا فأضف مقابلها في vercel.json، والعكس.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# الصور تُنشر من اللوحة (products و icons) ويبدّلها صاحب المحل
/assets/img/*
  Cache-Control: public, max-age=60, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/admin
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/manifest-admin.json
  Cache-Control: public, max-age=0, must-revalidate
